APP_NAME=Commerce Platform
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://commerce_user:CHANGE_ME@127.0.0.1:5432/commerce
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["https://shop.example.com","https://admin.example.com"]

ADMIN_SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=lax

API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
PUBLIC_BASE_URL=https://shop.example.com

PAYMENT_PROVIDER=mock
PAYMENT_LIVE_MODE=false
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_HMAC_SECRET

SHIPPING_PROVIDER=manual
SHIPPING_TRACKING_BASE_URL=https://www.baidu.com/s?wd=

OPS_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
